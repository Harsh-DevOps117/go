# Use `make setup` to create .env with random development credentials.
# This file is documentation; do not use these placeholders as credentials.
APP_ENV=development
PORT=3000
AUTO_MIGRATE=true
JWT_SECRET=replace-with-at-least-32-random-bytes
POSTGRES_PASSWORD=replace-with-random-password
DATABASE_URL=postgres://noteflow:replace-with-random-password@127.0.0.1:5432/noteflow?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0
TRUSTED_PROXIES=
