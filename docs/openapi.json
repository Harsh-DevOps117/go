{
  "openapi": "3.1.0",
  "info": {
    "title": "NoteFlow API",
    "version": "2.0.0",
    "description": "Gin API for private notes and reminders. Requests are capped at 1 MiB. All responses carry X-Request-ID and Cache-Control: no-store. Authentication endpoints share a 10/min/IP budget; the API has a 120/min/IP budget."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
